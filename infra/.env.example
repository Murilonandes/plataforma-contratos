# Copie para infra/.env (gitignored) e preencha. Uso:
#   docker compose -f infra/compose.dev.yml --env-file infra/.env up
# NUNCA versionar o .env com credenciais reais.

# ---- Postgres (so dev local) ----
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=contratos

# ---- App ----
APP_ENV=dev
LOG_LEVEL=INFO

# ---- SAP ----
# Unico host conhecido (DEV, client 300).
SAP_BASE_URL=https://s4-dev.brfertil.com.br/sap/opu/odata4/sap/zapi_contrato_vendas_o4/srvd_a2x/sap/zapi_contrato_vendas/0001/
SAP_CLIENT=300

# OBRIGATORIO em qualquer APP_ENV: hostnames de PRD separados por virgula,
# so hostname (sem https://, sem porta). Sem isso a api NAO sobe (fail-closed:
# e o que garante que dev/qas nunca apontem para PRD). Nenhum default no codigo.
SAP_PRD_HOSTS=

# Credenciais do usuario tecnico. Via env so e aceito com APP_ENV=dev;
# em qas/prd vem de Docker secret (/run/secrets/sap_user, /run/secrets/sap_pass).
SAP_USER=
SAP_PASS=
